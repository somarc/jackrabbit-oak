FROM eclipse-temurin:11-jre

LABEL maintainer="Blockchain AEM"
LABEL description="Global read-only Oak repository for Blockchain AEM"

# Install curl for healthcheck
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy the fat JAR (includes all dependencies)
COPY target/oak-segment-consensus.jar /app/oak-segment-consensus.jar

# Create store directory with world-readable permissions for POC
RUN mkdir -p /var/oak-chain/segmentstore && \
    chmod -R 777 /var/oak-chain

# Expose port
EXPOSE 8090

# Health check endpoint (will return 200 when server is ready)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8090/health || exit 1

# Run the global store server
ENTRYPOINT ["java", "-jar", "/app/oak-segment-consensus.jar"]
CMD ["--port", "8090", "--store", "/var/oak-chain/segmentstore"]

