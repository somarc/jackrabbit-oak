FROM eclipse-temurin:11-jre

LABEL maintainer="Blockchain AEM"
LABEL description="Global read-only Oak repository for Blockchain AEM"

# Install curl for healthcheck
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy the fat JAR and entrypoint script
COPY oak-segment-consensus/target/oak-segment-consensus.jar /app/oak-segment-consensus.jar
COPY oak-segment-consensus/entrypoint.sh /entrypoint.sh

# Create store directory and install gosu
RUN mkdir -p /var/oak-chain && \
    chown -R 999:999 /app && \
    chmod +x /entrypoint.sh && \
    apt-get update && \
    apt-get install -y gosu && \
    rm -rf /var/lib/apt/lists/*

# Expose port
EXPOSE 8090

# Health check endpoint (will return 200 when server is ready)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8090/health || exit 1

# Run the global store server via entrypoint
ENTRYPOINT ["/entrypoint.sh"]
CMD ["--port", "8090", "--store", "/var/oak-chain/segmentstore-composite-mount-oak-chain"]

