<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>org.apache.jackrabbit</groupId>
    <artifactId>oak-parent</artifactId>
    <version>1.89-SNAPSHOT</version>
    <relativePath>../oak-parent/pom.xml</relativePath>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>oak-segment-consensus</artifactId>
  <name>Oak Segment Consensus (Blockchain AEM POC)</name>
  <description>Distributed consensus layer for Oak Segment Store - Blockchain AEM proof of concept</description>
  <packaging>bundle</packaging>

  <build>
      <plugins>
        <plugin>
          <groupId>org.apache.felix</groupId>
          <artifactId>maven-bundle-plugin</artifactId>
          <configuration>
            <instructions>
              <!-- BACK TO FRAGMENT: Only way to access internal oak-segment-tar APIs -->
              <!-- BundleActivator will manually register services (DS won't work in fragments) -->
              <Fragment-Host>org.apache.jackrabbit.oak-segment-tar</Fragment-Host>
              
              <!-- Specify our BundleActivator for manual service registration -->
              <Bundle-Activator>org.apache.jackrabbit.oak.segment.consensus.osgi.ConsensusActivator</Bundle-Activator>
              
              <!-- Export our own packages for use by other bundles -->
              <Export-Package>
                org.apache.jackrabbit.oak.segment.consensus,
                org.apache.jackrabbit.oak.segment.consensus.protocol,
                org.apache.jackrabbit.oak.segment.consensus.wallet,
                org.apache.jackrabbit.oak.segment.consensus.network,
                org.apache.jackrabbit.oak.segment.consensus.servlets,
                org.apache.jackrabbit.oak.segment.consensus.osgi,
                org.apache.jackrabbit.oak.segment.consensus.mount
              </Export-Package>
              
              <!-- Import packages - Bouncy Castle is optional for signature verification -->
              <Import-Package>
                org.bouncycastle.*;resolution:=optional,
                *
              </Import-Package>
            </instructions>
          </configuration>
        </plugin>
         <plugin>
           <groupId>org.apache.rat</groupId>
           <artifactId>apache-rat-plugin</artifactId>
          <configuration>
            <excludes>
              <exclude>Dockerfile.global-store</exclude>
              <exclude>dependency-reduced-pom.xml</exclude>
            </excludes>
           </configuration>
        </plugin>
        <!-- Skip remote-resources plugin (causes issues with JitPack dependencies through corporate Artifactory) -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-remote-resources-plugin</artifactId>
          <executions>
            <execution>
              <id>process-resource-bundles</id>
              <phase>none</phase>
            </execution>
          </executions>
        </plugin>
        <!-- Build executable uber JAR for GlobalStoreServer -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.4.1</version>
          <executions>
            <execution>
              <phase>package</phase>
              <goals>
                <goal>shade</goal>
              </goals>
              <configuration>
                <shadedArtifactAttached>true</shadedArtifactAttached>
                <shadedClassifierName>standalone</shadedClassifierName>
                <finalName>oak-segment-consensus</finalName>
                <transformers>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                    <mainClass>org.apache.jackrabbit.oak.segment.consensus.server.GlobalStoreServer</mainClass>
                  </transformer>
                </transformers>
                <artifactSet>
                  <includes>
                    <include>*:*</include>
                  </includes>
                </artifactSet>
                <filters>
                  <filter>
                    <artifact>*:*</artifact>
                    <excludes>
                      <exclude>META-INF/*.SF</exclude>
                      <exclude>META-INF/*.DSA</exclude>
                      <exclude>META-INF/*.RSA</exclude>
                    </excludes>
                  </filter>
                </filters>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </build>

   <!-- ====================================================================== -->
    <!-- D E P E N D E N C I E S -->
