{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak-chain.io/schemas/eip-8004/registration.schema.json",
  "title": "EIP-8004 Agent Registration",
  "type": "object",
  "required": ["type", "name", "description", "services"],
  "properties": {
    "type": {
      "type": "string",
      "const": "https://eips.ethereum.org/EIPS/eip-8004#registration-v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "endpoint", "version", "capabilities"],
        "properties": {
          "name": {"type": "string"},
          "endpoint": {"type": "string"},
          "version": {"type": "string"},
          "capabilities": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    },
    "supportedTrust": {
      "type": "array",
      "items": {"type": "string"}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
